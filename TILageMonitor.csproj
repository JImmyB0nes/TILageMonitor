<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TILageMonitor</AssemblyName>
    <RootNamespace>TILageMonitor</RootNamespace>
    <Product>TI-Lage Monitor</Product>
    <Title>TI-Lage Monitor</Title>
    <Description>Überwachung der gematik TI-Lage und TI-Statusinformationen</Description>
    <Company>Randy Carter</Company>
    <Authors>Randy Carter</Authors>
    <Copyright>© 2026 Randy Carter</Copyright>
    <Version>3.2.0</Version>
    <FileVersion>3.2.0.0</FileVersion>
    <AssemblyVersion>3.2.0.0</AssemblyVersion>
    <InformationalVersion>3.2.0</InformationalVersion>
    <ApplicationIcon>TILageMonitor.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Die Protokollschicht ist ohne Konnektor pruefbar. Damit die Tests an die internen
            Zerlegehilfen kommen (TakeMessage, HasOpeningEnvelope), muss der Testversammlung
            der Zugang offen stehen – ohne dass die App selbst davon etwas merkt. -->
    <InternalsVisibleTo Include="TILageMonitor.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="TILageMonitor.ico" />
    <Resource Include="docs\assets\app-icon-128.png" />
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>
  <Target Name="CopyIconBesideOutput" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\TILageMonitor.ico"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildProjectDirectory)\TILageMonitor.ico')" />
  </Target>
  <Target Name="CopyIconToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\TILageMonitor.ico"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildProjectDirectory)\TILageMonitor.ico')" />
  </Target>
</Project>
