<Window x:Class="TILageMonitor.ConnectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Konnektor"
        Width="1040"
        Height="900"
        MinWidth="760"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackground}"
        ShowInTaskbar="True">

    <Window.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SectionHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,8"/>
        </Style>
        <Style x:Key="ConnectorCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ChipBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextMain}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource ChipBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextMain}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Konnektor"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"/>
                <TextBlock Text="Lokale TI-Anbindung: Konnektor-Status, Kartenterminals, Karten, PIN-Verwaltung und Zertifikate"
                           FontSize="13"
                           Foreground="{DynamicResource TextMuted}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RefreshButton" Content="↻  Aktualisieren" Click="Refresh_Click" Margin="0,0,8,0"/>
                <Button x:Name="CopyReportButton" Content="📋  Bericht kopieren" Click="CopyReport_Click" ToolTip="Diagnosebericht in die Zwischenablage kopieren"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Status-Banner -->
                <Border x:Name="StatusBanner"
                        CornerRadius="14"
                        Padding="16,12"
                        Margin="0,0,0,14"
                        BorderThickness="1"
                        Background="{DynamicResource ChipBackground}"
                        BorderBrush="{DynamicResource BorderSubtle}">
                    <StackPanel>
                        <TextBlock x:Name="StatusTitle"
                                   Text="Noch nicht verbunden"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMain}"/>
                        <TextBlock x:Name="StatusDetail"
                                   Text="Zugangsdaten eintragen und „Speichern &amp; verbinden“ wählen."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Warnungen -->
                <Border x:Name="AlertsCard" Style="{StaticResource ConnectorCardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Hinweise" Style="{StaticResource SectionHeaderStyle}"/>
                        <StackPanel x:Name="AlertsPanel" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Verbindung -->
                <Border Style="{StaticResource ConnectorCardStyle}">
                    <Expander x:Name="ConnectionExpander" IsExpanded="True">
                        <Expander.Header>
                            <TextBlock Text="Verbindung" Style="{StaticResource SectionHeaderStyle}" Margin="4,0,0,0"/>
                        </Expander.Header>
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Werte aus der Konnektor-Administration (Infomodell: Mandant, Clientsystem, Arbeitsplatz). Das Client-Zertifikat (.p12) wird im Konnektor für dieses Clientsystem erzeugt bzw. hinterlegt."
                                       Style="{StaticResource SectionHintStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Konnektor-Adresse" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="HostBox" ToolTip="IP-Adresse oder Hostname, optional mit Port, z. B. 192.168.1.10 oder 10.0.0.5:8443"/>
                                <CheckBox Grid.Row="0" Grid.Column="2" x:Name="UseTlsToggle" Content="TLS (https)" Style="{DynamicResource ThemeAwareCheckBoxStyle}" Margin="12,0,0,8" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="1" Text="Client-Zertifikat (.p12)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="CertPathBox"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="Durchsuchen…" Click="BrowseCertificate_Click" Margin="12,0,0,8" Padding="12,5"/>

                                <TextBlock Grid.Row="2" Text="Zertifikats-Passwort" Style="{StaticResource FieldLabelStyle}"/>
                                <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="CertPasswordBox" ToolTip="Leer lassen, um das gespeicherte Passwort zu behalten"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="CertPasswordHint" Text="" Style="{StaticResource FieldLabelStyle}" Margin="12,0,0,8"/>

                                <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ClientCertInfo" Text="" Style="{StaticResource SectionHintStyle}" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="4" Text="Mandant-ID" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="MandantBox" ToolTip="Wie in der Konnektor-Administration hinterlegt. Nur A-Z, a-z, 0-9, - und _, 1–64 Zeichen – Punkte, Leerzeichen oder Umlaute quittieren viele Konnektoren mit 4000 Syntaxfehler"/>

                                <TextBlock Grid.Row="5" Text="Clientsystem-ID" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Grid.Row="5" Grid.Column="1" x:Name="ClientSystemBox" ToolTip="Wie in der Konnektor-Administration hinterlegt. Nur A-Z, a-z, 0-9, - und _, 1–64 Zeichen"/>

                                <TextBlock Grid.Row="6" Text="Arbeitsplatz-ID" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Grid.Row="6" Grid.Column="1" x:Name="WorkplaceBox" ToolTip="Wie in der Konnektor-Administration hinterlegt. Nur A-Z, a-z, 0-9, - und _, 1–64 Zeichen"/>

                                <TextBlock Grid.Row="7" Text="Benutzer-ID (optional)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Grid.Row="7" Grid.Column="1" x:Name="UserBox" ToolTip="Leer lassen, außer HBA-Operationen erfordern sie. Eine ungültige UserId (Punkt, Leerzeichen) lässt beim RISE-Konnektor alle Abfragen mit 4000 Syntaxfehler scheitern"/>
                            </Grid>

                            <Expander Margin="0,6,0,0">
                                <Expander.Header>
                                    <TextBlock Text="Erweitert" Foreground="{DynamicResource TextMain}" FontWeight="SemiBold" Margin="4,0,0,0"/>
                                </Expander.Header>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Basic-Auth Benutzer" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="BasicUserBox" ToolTip="Nur ausfüllen, wenn der Konnektor Benutzer/Passwort statt (oder zusätzlich zum) Zertifikat verlangt"/>

                                    <TextBlock Grid.Row="1" Text="Basic-Auth Passwort" Style="{StaticResource FieldLabelStyle}"/>
                                    <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="BasicPasswordBox" ToolTip="Leer lassen, um das gespeicherte Passwort zu behalten"/>

                                    <CheckBox Grid.Row="2" Grid.Column="1" x:Name="RewriteHostToggle"
                                              Content="Dienst-Endpunkte auf diese Adresse umleiten (empfohlen)"
                                              Style="{DynamicResource ThemeAwareCheckBoxStyle}"
                                              Margin="0,2,0,10"
                                              ToolTip="connector.sds enthält oft interne Hostnamen, die vom Arbeitsplatz nicht auflösbar sind"/>

                                    <TextBlock Grid.Row="3" Text="Konnektor-TLS-Zertifikat" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="PinnedThumbprintText" Text="nicht gepinnt" Foreground="{DynamicResource TextMain}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                    <Button Grid.Row="3" Grid.Column="2" Content="Vertrauen zurücksetzen" Click="ResetTrust_Click" Margin="12,0,0,8" Padding="12,5"/>
                                </Grid>
                            </Expander>

                            <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,12,0,12"/>

                            <WrapPanel>
                                <CheckBox x:Name="EnabledToggle" Content="Konnektor-Anbindung aktiv" Style="{DynamicResource ThemeAwareCheckBoxStyle}" Margin="0,0,24,8"/>
                                <CheckBox x:Name="MonitoringToggle" Content="Im Hintergrund überwachen (Toasts)" Style="{DynamicResource ThemeAwareCheckBoxStyle}" Margin="0,0,24,8"/>
                            </WrapPanel>
                            <WrapPanel>
                                <CheckBox x:Name="EventSubscriptionsToggle" Content="Ereignis-Abos (Karte rein/raus sofort, statt nur Pollen)" Style="{DynamicResource ThemeAwareCheckBoxStyle}" Margin="0,0,24,8"
                                          ToolTip="Die App lauscht auf einem lokalen TCP-Port. Schlaegt das Abo fehl, wird automatisch weiter gepollt."/>
                                <CheckBox x:Name="HistoryToggle" Content="Konnektor-Verlauf lokal speichern (14 Tage)" Style="{DynamicResource ThemeAwareCheckBoxStyle}" Margin="0,0,24,8"
                                          ToolTip="Für Timeline und Stoerdauer – auch dann, wenn die gematik-API nicht erreichbar ist"/>
                            </WrapPanel>
                            <TextBlock x:Name="EventStreamInfo" Text="" Style="{StaticResource SectionHintStyle}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <WrapPanel Margin="0,4,0,0">
                                <TextBlock Text="Intervall (Minuten)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="PollMinutesBox" Width="60" Margin="0,0,24,8"/>
                                <TextBlock Text="Zertifikatswarnung ab (Tage)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="CertWarnDaysBox" Width="60"/>
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="SaveConnectButton" Content="Speichern &amp; verbinden" Style="{StaticResource AccentButtonStyle}" Padding="16,9" Click="SaveConnect_Click" Margin="0,0,8,0"/>
                                <Button x:Name="TestButton" Content="Nur testen" Padding="16,9" Click="Test_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- Konnektor -->
                <Border x:Name="ConnectorInfoCard" Style="{StaticResource ConnectorCardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Konnektor" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Produktinformationen (connector.sds) und Betriebszustand (GetResourceInformation)" Style="{StaticResource SectionHintStyle}"/>
                        <Grid x:Name="ConnectorInfoGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Karten -->
                <Border x:Name="CardsCard" Style="{StaticResource ConnectorCardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Karten" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="SMC-B und HBA: PIN-Eingaben erfolgen ausschließlich am Kartenterminal – die App sieht keine PIN oder PUK."
                                   Style="{StaticResource SectionHintStyle}"/>
                        <StackPanel x:Name="CardsPanel"/>
                    </StackPanel>
                </Border>

                <!-- Terminals -->
                <Border x:Name="TerminalsCard" Style="{StaticResource ConnectorCardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Kartenterminals" Style="{StaticResource SectionHeaderStyle}"/>
                        <StackPanel x:Name="TerminalsPanel" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Dienste -->
                <Border x:Name="ServicesCard" Style="{StaticResource ConnectorCardStyle}" Visibility="Collapsed">
                    <Expander>
                        <Expander.Header>
                            <TextBlock Text="Dienstverzeichnis (connector.sds)" Style="{StaticResource SectionHeaderStyle}" Margin="4,0,0,0"/>
                        </Expander.Header>
                        <StackPanel x:Name="ServicesPanel" Margin="0,10,0,0"/>
                    </Expander>
                </Border>

                <!-- Protokoll -->
                <Border Style="{StaticResource ConnectorCardStyle}">
                    <Expander>
                        <Expander.Header>
                            <TextBlock Text="Protokoll" Style="{StaticResource SectionHeaderStyle}" Margin="4,0,0,0"/>
                        </Expander.Header>
                        <TextBox x:Name="LogBox"
                                 Margin="0,10,0,0"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="140"
                                 MaxHeight="260"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="11"/>
                    </Expander>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="FooterText" Text="" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
            <Button Content="Schließen" HorizontalAlignment="Right" MinWidth="110" Click="Close_Click" Padding="16,10"/>
        </Grid>
    </Grid>
</Window>
