<Window x:Class="TILageMonitor.ConnectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Konnektor"
        Width="1120"
        Height="820"
        MinWidth="820"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackground}"
        ShowInTaskbar="True">

    <Window.Resources>
        <!-- ============================================================
           Text
           ============================================================ -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        </Style>
        <Style x:Key="SectionHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="0,3,0,14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="MonoStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ============================================================
           Flächen
           ============================================================ -->
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SubtlePanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ChipBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <!-- Kleine Info-Kapsel: Label winzig darüber, Wert daneben -->
        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ChipBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>

        <!-- ============================================================
           Eingaben
           ============================================================ -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ChipBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextMain}"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource ChipBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextMain}"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- Schlanke Zeile für Erweitern-Ablagen, damit XML nicht im Weg steht -->
        <Style x:Key="DisclosureStyle" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <!-- ============================================================
           Reiter als Segmentsteuerung
           ============================================================ -->
        <Style x:Key="PillTabStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Pill"
                                CornerRadius="999"
                                Padding="15,7"
                                Margin="0,0,6,0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource ChipBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource CardBackground}"/>
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabHostStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Padding="0,0,0,14">
                                <WrapPanel IsItemsHost="True"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================= Kopf ============================= -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="12"
                        Background="{DynamicResource AppIconCircleBackground}"
                        VerticalAlignment="Center" Margin="0,0,13,0">
                    <TextBlock Text="⌁"
                               FontSize="19"
                               Foreground="{DynamicResource AppIconForeground}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Konnektor"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMain}"/>
                    <TextBlock Text="Status · Terminals · Karten · PIN · Zertifikate"
                               FontSize="12"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RefreshButton" Content="↻  Aktualisieren" Click="Refresh_Click" Margin="0,0,8,0" Padding="14,8"/>
                <Button x:Name="CopyReportButton" Content="⧉  Bericht" Click="CopyReport_Click" Padding="14,8"
                        ToolTip="Diagnosebericht in die Zwischenablage kopieren"/>
            </StackPanel>
        </Grid>

        <!-- ========================= Statusbanner ========================= -->
        <Border x:Name="StatusBanner"
                Grid.Row="1"
                CornerRadius="14"
                Padding="16,13"
                Margin="0,0,0,14"
                BorderThickness="1"
                Background="{DynamicResource ChipBackground}"
                BorderBrush="{DynamicResource BorderSubtle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="StatusIconCircle"
                        Width="34" Height="34"
                        CornerRadius="17"
                        Background="{DynamicResource StatusEmpty}"
                        VerticalAlignment="Center"
                        Margin="0,0,13,0">
                    <TextBlock x:Name="StatusGlyph"
                               Text="•"
                               FontSize="15"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTitle"
                               Text="Noch nicht verbunden"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMain}"/>
                    <TextBlock x:Name="StatusDetail"
                               Text="Zugangsdaten eintragen und „Speichern &amp; verbinden“ wählen."
                               FontSize="12"
                               Foreground="{DynamicResource TextMuted}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <WrapPanel x:Name="StatusChips" Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Grid>
        </Border>

        <!-- ============================ Reiter ============================ -->
        <TabControl x:Name="Tabs" Grid.Row="2" Style="{StaticResource TabHostStyle}">

            <!-- ---------------------- Übersicht ---------------------- -->
            <TabItem Header="Übersicht" Style="{StaticResource PillTabStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border x:Name="AlertsCard" Style="{StaticResource PanelStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Hinweise" Style="{StaticResource SectionTitleStyle}"/>
                                <StackPanel x:Name="AlertsPanel" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ConnectorInfoCard" Style="{StaticResource PanelStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Konnektor" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="Aus connector.sds und GetResourceInformation"
                                           Style="{StaticResource SectionHintStyle}"/>
                                <WrapPanel x:Name="ConnectorInfoGrid"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ------------------------ Karten ------------------------ -->
            <TabItem Header="Karten" Style="{StaticResource PillTabStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border x:Name="CardsCard" Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Karten" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="PIN-Eingaben erfolgen ausschließlich am Kartenterminal – die App sieht keine PIN oder PUK."
                                           Style="{StaticResource SectionHintStyle}"/>
                                <StackPanel x:Name="CardsPanel"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ---------------------- Terminals ---------------------- -->
            <TabItem Header="Terminals" Style="{StaticResource PillTabStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border x:Name="TerminalsCard" Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Kartenterminals" Style="{StaticResource SectionTitleStyle}"/>
                                <StackPanel x:Name="TerminalsPanel" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- --------------------- Verbindung --------------------- -->
            <TabItem x:Name="ConnectionTab" Header="Verbindung" Style="{StaticResource PillTabStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Der Name ConnectionExpander bleibt erhalten: Er steuert, ob das
                             Formular nach erfolgreichem Test automatisch zuklappt. -->
                        <Expander x:Name="ConnectionExpander" IsExpanded="True">
                            <Expander.Header>
                                <TextBlock Text="Zugang und Aufrufkontext" Style="{StaticResource SectionTitleStyle}" Margin="4,0,0,0"/>
                            </Expander.Header>
                            <StackPanel Margin="0,12,0,0">
                                <Border Style="{StaticResource SubtlePanelStyle}">
                                    <TextBlock Text="Werte aus der Konnektor-Administration. Das Client-Zertifikat (.p12) wird im Konnektor für dieses Clientsystem erzeugt bzw. hinterlegt."
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMuted}"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <Border Style="{StaticResource PanelStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                            <TextBlock Text="Konnektor-Adresse" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="HostBox"
                                                     ToolTip="IP oder Hostname, optional mit Port, z. B. 192.168.1.10 oder 10.0.0.5:8443"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                                            <TextBlock Text="Übertragung" Style="{StaticResource FieldLabelStyle}"/>
                                            <CheckBox x:Name="UseTlsToggle" Content="TLS (https)"
                                                      Style="{DynamicResource ThemeAwareCheckBoxStyle}"
                                                      VerticalAlignment="Center" Margin="0,7,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
                                            <TextBlock Text="Client-Zertifikat (.p12)" Style="{StaticResource FieldLabelStyle}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="CertPathBox"/>
                                                <Button Grid.Column="1" Content="Durchsuchen…" Click="BrowseCertificate_Click"
                                                        Margin="8,0,0,0" Padding="13,7"/>
                                            </Grid>
                                            <TextBlock x:Name="CertPasswordHint" Text="" FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
                                            <TextBlock Text="Passwort" Style="{StaticResource FieldLabelStyle}"/>
                                            <PasswordBox x:Name="CertPasswordBox"
                                                         ToolTip="Leer lassen, um das gespeicherte Passwort zu behalten"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                                   x:Name="ClientCertInfo" Text=""
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMuted}"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource PanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Aufrufkontext" Style="{StaticResource SectionTitleStyle}" FontSize="14"/>
                                        <TextBlock Text="Genau die Werte aus der Konnektor-Administration verwenden. Erlaubt sind A-Z, a-z, 0-9, - und _, 1–64 Zeichen."
                                                   Style="{StaticResource SectionHintStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                                <TextBlock Text="Mandant-ID" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox x:Name="MandantBox"
                                                         ToolTip="Nur A-Z, a-z, 0-9, - und _. Punkte oder Leerzeichen quittieren viele Konnektoren mit 4000 Syntaxfehler"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                                                <TextBlock Text="Clientsystem-ID" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox x:Name="ClientSystemBox"
                                                         ToolTip="Wie in der Konnektor-Administration hinterlegt"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                                                <TextBlock Text="Arbeitsplatz-ID" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox x:Name="WorkplaceBox"
                                                         ToolTip="Wie in der Konnektor-Administration hinterlegt"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                                                <TextBlock Text="Benutzer-ID (optional)" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox x:Name="UserBox"
                                                         ToolTip="Leer lassen, außer HBA-Operationen erfordern sie"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource PanelStyle}">
                                    <Expander Style="{StaticResource DisclosureStyle}">
                                        <Expander.Header>
                                            <TextBlock Text="Erweitert" FontWeight="SemiBold"/>
                                        </Expander.Header>
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                                <TextBlock Text="Basic-Auth Benutzer" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox x:Name="BasicUserBox"
                                                         ToolTip="Nur, wenn der Konnektor Benutzer/Passwort statt eines Zertifikats verlangt"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                                                <TextBlock Text="Basic-Auth Passwort" Style="{StaticResource FieldLabelStyle}"/>
                                                <PasswordBox x:Name="BasicPasswordBox"
                                                             ToolTip="Leer lassen, um das gespeicherte Passwort zu behalten"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
                                                <CheckBox x:Name="RewriteHostToggle"
                                                          Content="Dienst-Endpunkte auf diese Adresse umleiten (empfohlen)"
                                                          Style="{DynamicResource ThemeAwareCheckBoxStyle}"
                                                          ToolTip="connector.sds enthält oft interne Hostnamen, die vom Arbeitsplatz nicht auflösbar sind"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                                <TextBlock Text="Gepinntes TLS-Zertifikat" Style="{StaticResource FieldLabelStyle}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="PinnedThumbprintText" Text="nicht gepinnt"
                                                               Style="{StaticResource MonoStyle}"
                                                               VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Content="Vertrauen zurücksetzen"
                                                            Click="ResetTrust_Click" Padding="13,7"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Expander>
                                </Border>

                                <Border Style="{StaticResource PanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Verhalten" Style="{StaticResource SectionTitleStyle}" FontSize="14"/>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <CheckBox x:Name="EnabledToggle" Grid.Row="0" Grid.Column="0"
                                                      Content="Konnektor-Anbindung aktiv"
                                                      Style="{DynamicResource ThemeAwareCheckBoxStyle}" Margin="0,0,0,10"/>
                                            <CheckBox x:Name="MonitoringToggle" Grid.Row="0" Grid.Column="1"
                                                      Content="Im Hintergrund überwachen (Toasts)"
                                                      Style="{DynamicResource ThemeAwareCheckBoxStyle}" Margin="0,0,0,10"/>
                                            <CheckBox x:Name="EventSubscriptionsToggle" Grid.Row="1" Grid.Column="0"
                                                      Content="Ereignis-Abos (Karte rein/raus sofort)"
                                                      Style="{DynamicResource ThemeAwareCheckBoxStyle}" Margin="0,0,0,10"
                                                      ToolTip="Die App lauscht auf einem lokalen TCP-Port. Schlägt das Abo fehl, wird automatisch weiter gepollt."/>
                                            <CheckBox x:Name="HistoryToggle" Grid.Row="1" Grid.Column="1"
                                                      Content="Verlauf lokal speichern (14 Tage)"
                                                      Style="{DynamicResource ThemeAwareCheckBoxStyle}" Margin="0,0,0,10"
                                                      ToolTip="Für Timeline und Störungsdauer – auch wenn die gematik-API nicht erreichbar ist"/>
                                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="Intervall" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBox x:Name="PollMinutesBox" Width="58"/>
                                                <TextBlock Text="Min." Style="{StaticResource FieldLabelStyle}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="Warnung ab" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBox x:Name="CertWarnDaysBox" Width="58"/>
                                                <TextBlock Text="Tage" Style="{StaticResource FieldLabelStyle}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="EventStreamInfo" Text="" FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Button x:Name="SaveConnectButton" Content="Speichern &amp; verbinden"
                                            Style="{StaticResource AccentButtonStyle}" Padding="18,10" Margin="0,0,8,0"
                                            Click="SaveConnect_Click"/>
                                    <Button x:Name="TestButton" Content="Nur testen" Padding="18,10" Click="Test_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ----------------------- Dienste ----------------------- -->
            <TabItem Header="Dienste" Style="{StaticResource PillTabStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border x:Name="ServicesCard" Style="{StaticResource PanelStyle}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Dienstverzeichnis" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Aus connector.sds – Name, Version und Erreichbarkeit der angebotenen Dienste"
                                       Style="{StaticResource SectionHintStyle}"/>
                            <StackPanel x:Name="ServicesPanel"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ---------------------- Protokoll ---------------------- -->
            <TabItem Header="Protokoll" Style="{StaticResource PillTabStyle}">
                <Border Style="{StaticResource PanelStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Ablauf des letzten Abrufs"
                                   Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                        <TextBox x:Name="LogBox"
                                 DockPanel.Dock="Bottom"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="360"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="11"/>
                    </DockPanel>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ============================ Fuß ============================ -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="FooterText" Text="" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMuted}" FontSize="12"/>
            <Button Content="Schließen" HorizontalAlignment="Right" MinWidth="110" Click="Close_Click" Padding="16,9"/>
        </Grid>
    </Grid>
</Window>
