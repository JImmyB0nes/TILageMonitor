<Window x:Class="TILageMonitor.ConnectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Konnektor"
        Width="1120"
        Height="820"
        MinWidth="820"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackground}"
        ShowInTaskbar="True">

    <Window.Resources>
        <!-- ============================================================
           Text
           ============================================================ -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        </Style>
        <Style x:Key="SectionHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="0,3,0,14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="MonoStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ============================================================
           Flächen
           ============================================================ -->
        <!-- Kein Style, sondern das Objekt selbst: Effect verlangt einen DropShadowEffect.
             x:Shared="False" liefert jeden Aufruf eine eigene Wirkung – dieselbe Instanz auf
             mehrere Elemente zu setzen, quittiert WPF mit einer Einfacheigenschaft. -->
        <DropShadowEffect x:Key="CardShadow" x:Shared="False"
                          BlurRadius="18" ShadowDepth="2" Direction="270"
                          Opacity="0.10" Color="#000000"/>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>
        <Style x:Key="SubtlePanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ChipBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <!-- Kennzahl im Banner: Wert groß, darüber die winzige Bezeichnung. -->
        <Style x:Key="KpiStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>
        <!-- Info-Kapsel: winzige Bezeichnung, darunter der Wert. Steht im Code unter "Chip". -->
        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ChipBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,7,7"/>
        </Style>

        <!-- ============================================================
           Eingaben
           ============================================================ -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ChipBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextMain}"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource ChipBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextMain}"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- Schlanke Zeile für Erweitern-Ablagen, damit XML nicht im Weg steht -->
        <Style x:Key="DisclosureStyle" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <!-- ============================================================
           Reiter als Segmentsteuerung
           ============================================================ -->
        
        <!-- Seitenleiste: Verzeichnis der Abschnitte. Die Reiter des TabControls bleiben
             als Inhalttrager erhalten, ihre Kopfzeile wird nicht mehr gezeichnet. -->
        <Style x:Key="NavStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="11,9"/>
                        <Setter Property="Margin" Value="0,1,0,1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" CornerRadius="10" Background="Transparent"
                                            BorderBrush="Transparent" BorderThickness="1"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource ChipBackground}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource CardBackground}"/>
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
                                            <Setter TargetName="Row" Property="Effect" Value="{StaticResource CardShadow}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Der Reiterkopf entfaltet, aber die Reiter bleiben als Inhalttrager bestehen.
             Ohne IsItemsHost-Panel wirft die Vorlage eine Laufzeit-Ausnahme, deshalb steht
             es hier nur ausgebreitet da. -->
        <Style x:Key="HiddenTabHostStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <WrapPanel IsItemsHost="True" Visibility="Collapsed"/>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

            </Window.Resources>

    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================= Kopf ============================= -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <!-- Vektor statt Emoji, damit die Kante mit dem Hauptfenster identisch bleibt. -->
                <Border Width="40" Height="40" CornerRadius="12"
                        Background="{DynamicResource AppIconCircleBackground}"
                        VerticalAlignment="Center" Margin="0,0,13,0">
                    <Viewbox Width="21" Height="21" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="{DynamicResource AppIconForeground}" StrokeThickness="1.8"
                                  StrokeLineCap="Round" StrokeLineJoin="Round"
                                  Data="M13,2 L4,14 H10 L9,22 L19,10 H13 Z"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Konnektor"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMain}"/>
                    <TextBlock Text="Status · Terminals · Karten · PIN · Zertifikate"
                               FontSize="12"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RefreshButton" Click="Refresh_Click" Margin="0,0,8,0" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="{DynamicResource ButtonForeground}" StrokeThickness="1.9"
                                      StrokeLineCap="Round" StrokeLineJoin="Round"
                                      Data="M21,12 A9,9 0 1 1 18,5.3 M21,3 V9 H15"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Aktualisieren"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CopyReportButton" Click="CopyReport_Click" Padding="14,8"
                        ToolTip="Diagnosebericht in die Zwischenablage kopieren">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="{DynamicResource ButtonForeground}" StrokeThickness="1.8"
                                      StrokeLineJoin="Round"
                                      Data="M9,3 H19 V17 M5,7 H15 V21 H5 Z"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Bericht"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ========================= Statusbanner ========================= -->
        <Border x:Name="StatusBanner"
                Grid.Row="1"
                CornerRadius="14"
                Padding="16,13"
                Margin="0,0,0,14"
                BorderThickness="1"
                Background="{DynamicResource ChipBackground}"
                BorderBrush="{DynamicResource BorderSubtle}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.10" Direction="270" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="StatusIconCircle"
                        Width="34" Height="34"
                        CornerRadius="17"
                        Background="{DynamicResource StatusEmpty}"
                        VerticalAlignment="Center"
                        Margin="0,0,13,0">
                    <TextBlock x:Name="StatusGlyph"
                               Text="•"
                               FontSize="15"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTitle"
                               Text="Noch nicht verbunden"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMain}"/>
                    <TextBlock x:Name="StatusDetail"
                               Text="Zugangsdaten eintragen und „Speichern &amp; verbinden“ wählen."
                               FontSize="12"
                               Foreground="{DynamicResource TextMuted}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <WrapPanel x:Name="StatusChips" Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Grid>
        </Border>

        <!-- ==================== Seitenleiste + Inhalt ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="186"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Die Auswahl hier ist dieselbe Auswahl der Reiter, damit der bestehende
                 Code (Tabs.SelectedIndex, Tabs.SelectedItem) ohne Umbau weitertragt. -->
            <ListBox x:Name="Nav" Grid.Column="0" Style="{StaticResource NavStyle}"
                     SelectionChanged="Nav_SelectionChanged">
                <ListBoxItem x:Name="NavOverview">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="{DynamicResource TextMuted}" StrokeThickness="1.7"
                                      Data="M2,12 C5,6 19,6 22,12 C19,18 5,18 2,12 Z"/>
                                <Path Fill="{DynamicResource TextMuted}" Data="M12,9 A3,3 0 1 1 12,15 A3,3 0 1 1 12,9 Z"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Übersicht" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="NavCards">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="{DynamicResource TextMuted}" StrokeThickness="1.7"
                                      StrokeLineJoin="Round"
                                      Data="M2,6 H22 V18 H2 Z M2,10 H22"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Karten" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NavCardsCount" Text="" VerticalAlignment="Center"
                                   Margin="0,0,0,0" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="NavTerminals">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="{DynamicResource TextMuted}" StrokeThickness="1.7"
                                      StrokeLineCap="Round" StrokeLineJoin="Round"
                                      Data="M3,4 H21 V16 H3 Z M8,20 H16 M12,16 V20"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Terminals" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NavTerminalsCount" Text="" VerticalAlignment="Center"
                                   Margin="0,0,0,0" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="NavConnection">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="{DynamicResource TextMuted}" StrokeThickness="1.7"
                                      StrokeLineCap="Round" StrokeLineJoin="Round"
                                      Data="M9,2 V8 M15,2 V8 M6,8 H18 V11 A6,6 0 0 1 6,11 Z M12,17 V22"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Verbindung" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="NavServices">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="{DynamicResource TextMuted}" StrokeThickness="1.7"
                                      Data="M12,3 A9,9 0 1 1 12,21 A9,9 0 1 1 12,3 Z M3,12 H21 M12,3 A14,14 0 0 1 12,21 M12,3 A14,14 0 0 0 12,21"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Dienste" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="NavLog">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="{DynamicResource TextMuted}" StrokeThickness="1.7"
                                      StrokeLineJoin="Round" Data="M4,3 H20 V21 H4 Z M8,8 H16 M8,12 H16 M8,16 H13"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Protokoll" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

            <TabControl x:Name="Tabs" Grid.Column="2" Style="{StaticResource HiddenTabHostStyle}">

            <!-- ====================== Übersicht ====================== -->
            <TabItem Header="Übersicht">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border x:Name="AlertsCard" Style="{StaticResource PanelStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Hinweise" Style="{StaticResource SectionTitleStyle}"/>
                                <StackPanel x:Name="AlertsPanel" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ConnectorInfoCard" Style="{StaticResource PanelStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Konnektor" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="Aus connector.sds und GetResourceInformation"
                                           Style="{StaticResource SectionHintStyle}"/>
                                <WrapPanel x:Name="ConnectorInfoGrid"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================== Karten ======================== -->
            <!-- Zwei Spalten: links die Auswahl, rechts der ganze Detailtext. Ein Stapel
                 Karten waere bei mehreren Karten halbhoh Fullbildlauf, die Liste bleibt
                 dagegen immer auf demselben Stand. -->
            <TabItem Header="Karten">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Padding="10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="4,4,4,10">
                                <TextBlock Text="Karten" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock x:Name="CardsCountText" Text="" FontSize="12"
                                           Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ListBox x:Name="CardsList" Style="{StaticResource NavStyle}"
                                     SelectionChanged="CardsList_SelectionChanged"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" x:Name="CardsCard" Style="{StaticResource PanelStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="CardDetailPanel"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ====================== Terminals ====================== -->
            <TabItem Header="Terminals">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Padding="10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="4,4,4,10">
                                <TextBlock Text="Kartenterminals" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock x:Name="TerminalsCountText" Text="" FontSize="12"
                                           Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ListBox x:Name="TerminalsList" Style="{StaticResource NavStyle}"
                                     SelectionChanged="TerminalsList_SelectionChanged"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" x:Name="TerminalsCard" Style="{StaticResource PanelStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="TerminalDetailPanel"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===================== Verbindung ===================== -->
            <TabItem x:Name="ConnectionTab" Header="Verbindung">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Der Name ConnectionExpander bleibt erhalten: Er steuert, ob das
                             Formular nach erfolgreichem Test automatisch zuklappt. -->
                        <Expander x:Name="ConnectionExpander" IsExpanded="True">
                            <Expander.Header>
                                <TextBlock Text="Zugang und Aufrufkontext" Style="{StaticResource SectionTitleStyle}" Margin="4,0,0,0"/>
                            </Expander.Header>
                            <StackPanel Margin="0,12,0,0">
                                <Border Style="{StaticResource SubtlePanelStyle}">
                                    <TextBlock Text="Werte aus der Konnektor-Administration. Das Client-Zertifikat (.p12) wird im Konnektor für dieses Clientsystem erzeugt bzw. hinterlegt."
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMuted}"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <Border Style="{StaticResource PanelStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                            <TextBlock Text="Konnektor-Adresse" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="HostBox"
                                                     ToolTip="IP oder Hostname, optional mit Port, z. B. 192.168.1.10 oder 10.0.0.5:8443"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                                            <TextBlock Text="Übertragung" Style="{StaticResource FieldLabelStyle}"/>
                                            <CheckBox x:Name="UseTlsToggle" Content="TLS (https)"
                                                      Style="{DynamicResource ThemeAwareCheckBoxStyle}"
                                                      VerticalAlignment="Center" Margin="0,7,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
                                            <TextBlock Text="Client-Zertifikat (.p12)" Style="{StaticResource FieldLabelStyle}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="CertPathBox"/>
                                                <Button Grid.Column="1" Content="Durchsuchen…" Click="BrowseCertificate_Click"
                                                        Margin="8,0,0,0" Padding="13,7"/>
                                            </Grid>
                                            <TextBlock x:Name="CertPasswordHint" Text="" FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
                                            <TextBlock Text="Passwort" Style="{StaticResource FieldLabelStyle}"/>
                                            <PasswordBox x:Name="CertPasswordBox"
                                                         ToolTip="Leer lassen, um das gespeicherte Passwort zu behalten"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                                   x:Name="ClientCertInfo" Text=""
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMuted}"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource PanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Aufrufkontext" Style="{StaticResource SectionTitleStyle}" FontSize="14"/>
                                        <TextBlock Text="Genau die Werte aus der Konnektor-Administration verwenden. Erlaubt sind A-Z, a-z, 0-9, - und _, 1–64 Zeichen."
                                                   Style="{StaticResource SectionHintStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                                <TextBlock Text="Mandant-ID" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox x:Name="MandantBox"
                                                         ToolTip="Nur A-Z, a-z, 0-9, - und _. Punkte oder Leerzeichen quittieren viele Konnektoren mit 4000 Syntaxfehler"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                                                <TextBlock Text="Clientsystem-ID" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox x:Name="ClientSystemBox"
                                                         ToolTip="Wie in der Konnektor-Administration hinterlegt"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                                                <TextBlock Text="Arbeitsplatz-ID" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox x:Name="WorkplaceBox"
                                                         ToolTip="Wie in der Konnektor-Administration hinterlegt"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                                                <TextBlock Text="Benutzer-ID (optional)" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox x:Name="UserBox"
                                                         ToolTip="Leer lassen, außer HBA-Operationen erfordern sie"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource PanelStyle}">
                                    <Expander Style="{StaticResource DisclosureStyle}">
                                        <Expander.Header>
                                            <TextBlock Text="Erweitert" FontWeight="SemiBold"/>
                                        </Expander.Header>
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                                <TextBlock Text="Basic-Auth Benutzer" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox x:Name="BasicUserBox"
                                                         ToolTip="Nur, wenn der Konnektor Benutzer/Passwort statt eines Zertifikats verlangt"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                                                <TextBlock Text="Basic-Auth Passwort" Style="{StaticResource FieldLabelStyle}"/>
                                                <PasswordBox x:Name="BasicPasswordBox"
                                                             ToolTip="Leer lassen, um das gespeicherte Passwort zu behalten"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
                                                <CheckBox x:Name="RewriteHostToggle"
                                                          Content="Dienst-Endpunkte auf diese Adresse umleiten (empfohlen)"
                                                          Style="{DynamicResource ThemeAwareCheckBoxStyle}"
                                                          ToolTip="connector.sds enthält oft interne Hostnamen, die vom Arbeitsplatz nicht auflösbar sind"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                                <TextBlock Text="Gepinntes TLS-Zertifikat" Style="{StaticResource FieldLabelStyle}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="PinnedThumbprintText" Text="nicht gepinnt"
                                                               Style="{StaticResource MonoStyle}"
                                                               VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Content="Vertrauen zurücksetzen"
                                                            Click="ResetTrust_Click" Padding="13,7"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Expander>
                                </Border>

                                <Border Style="{StaticResource PanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Verhalten" Style="{StaticResource SectionTitleStyle}" FontSize="14"/>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <CheckBox x:Name="EnabledToggle" Grid.Row="0" Grid.Column="0"
                                                      Content="Konnektor-Anbindung aktiv"
                                                      Style="{DynamicResource ThemeAwareCheckBoxStyle}" Margin="0,0,0,10"/>
                                            <CheckBox x:Name="MonitoringToggle" Grid.Row="0" Grid.Column="1"
                                                      Content="Im Hintergrund überwachen (Toasts)"
                                                      Style="{DynamicResource ThemeAwareCheckBoxStyle}" Margin="0,0,0,10"/>
                                            <CheckBox x:Name="EventSubscriptionsToggle" Grid.Row="1" Grid.Column="0"
                                                      Content="Ereignis-Abos (Karte rein/raus sofort)"
                                                      Style="{DynamicResource ThemeAwareCheckBoxStyle}" Margin="0,0,0,10"
                                                      ToolTip="Die App lauscht auf einem lokalen TCP-Port. Schlägt das Abo fehl, wird automatisch weiter gepollt."/>
                                            <CheckBox x:Name="HistoryToggle" Grid.Row="1" Grid.Column="1"
                                                      Content="Verlauf lokal speichern (14 Tage)"
                                                      Style="{DynamicResource ThemeAwareCheckBoxStyle}" Margin="0,0,0,10"
                                                      ToolTip="Für Timeline und Störungsdauer – auch wenn die gematik-API nicht erreichbar ist"/>
                                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="Intervall" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBox x:Name="PollMinutesBox" Width="58"/>
                                                <TextBlock Text="Min." Style="{StaticResource FieldLabelStyle}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="Warnung ab" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBox x:Name="CertWarnDaysBox" Width="58"/>
                                                <TextBlock Text="Tage" Style="{StaticResource FieldLabelStyle}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="EventStreamInfo" Text="" FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Button x:Name="SaveConnectButton" Content="Speichern &amp; verbinden"
                                            Style="{StaticResource AccentButtonStyle}" Padding="18,10" Margin="0,0,8,0"
                                            Click="SaveConnect_Click"/>
                                    <Button x:Name="TestButton" Content="Nur testen" Padding="18,10" Click="Test_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================= Dienste ======================= -->
            <TabItem Header="Dienste">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border x:Name="ServicesCard" Style="{StaticResource PanelStyle}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Dienstverzeichnis" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Aus connector.sds – Name, Version und Erreichbarkeit der angebotenen Dienste"
                                       Style="{StaticResource SectionHintStyle}"/>
                            <StackPanel x:Name="ServicesPanel"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ====================== Protokoll ====================== -->
            <TabItem Header="Protokoll">
                <Border Style="{StaticResource PanelStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Ablauf des letzten Abrufs"
                                   Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                        <TextBox x:Name="LogBox"
                                 DockPanel.Dock="Bottom"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="360"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="11"/>
                    </DockPanel>
                </Border>
            </TabItem>
            </TabControl>
        </Grid>

        <!-- ============================ Fuß ============================ -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="FooterText" Text="" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMuted}" FontSize="12"/>
            <Button Content="Schließen" HorizontalAlignment="Right" MinWidth="110" Click="Close_Click" Padding="16,9"/>
        </Grid>
    </Grid>
</Window>
