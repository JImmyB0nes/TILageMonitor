<Window x:Class="TILageMonitor.ConnectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TILageMonitor"
        Title="Konnektor"
        Width="1180"
        Height="860"
        MinWidth="880"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        ShowInTaskbar="True">

    <!--
        Konnektor-Fenster im Fluent-Stil.
        Aufbau: Kopf mit Zustand und Kennzahlen · Navigationsleiste · Seiten · Statusleiste.
        Alle x:Name-Elemente des bisherigen Fensters bestehen weiter – der Code dahinter greift
        unverändert darauf zu. Nur Hüllen, Abstände und Vorlagen sind neu.
    -->

    <Window.Resources>
        <!-- ============================================================
           Typografie
           ============================================================ -->
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        </Style>
        <Style x:Key="PageHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,18"/>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="EyebrowStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="MonoStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Fluent-Symbole -->
        <Style x:Key="GlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Symbol in der Navigationsleiste: färbt sich mit der Auswahl. -->
        <Style x:Key="NavIconStyle" TargetType="TextBlock" BasedOn="{StaticResource GlyphStyle}">
            <Setter Property="Width" Value="22"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AppIconForeground}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Linien-Symbole (AppIcon) – Gegenstuecke zu GlyphStyle/IconTileGlyphStyle/NavIconStyle -->
        <Style x:Key="IconStyle" TargetType="local:AppIcon">
            <Setter Property="Size" Value="16"/>
            <Setter Property="Stroke" Value="{DynamicResource TextMain}"/>
        </Style>
        <Style x:Key="IconTileIconStyle" TargetType="local:AppIcon" BasedOn="{StaticResource IconStyle}">
            <Setter Property="Size" Value="18"/>
            <Setter Property="Stroke" Value="{DynamicResource AppIconForeground}"/>
        </Style>
        <Style x:Key="NavPathIconStyle" TargetType="local:AppIcon" BasedOn="{StaticResource IconStyle}">
            <Setter Property="Size" Value="18"/>
            <Setter Property="Margin" Value="2,0,14,0"/>
            <Setter Property="Stroke" Value="{DynamicResource TextMuted}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Stroke" Value="{DynamicResource AppIconForeground}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Segment-Umschalter (zwei bis drei gleichrangige Optionen) -->
        <Style x:Key="SegmentStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
           Flächen
           ============================================================ -->
        <DropShadowEffect x:Key="CardShadow" x:Shared="False"
                          BlurRadius="24" ShadowDepth="3" Direction="270"
                          Opacity="0.07" Color="#000000"/>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22,20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>
        <Style x:Key="SubtlePanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ChipBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <!-- Kennzahl-Kachel im Kopf -->
        <Style x:Key="KpiStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <!-- Eigenschafts-Kachel: kleine Bezeichnung, darunter der Wert -->
        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ChipBackground}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>
        <!-- Symbolkachel vor Abschnittsüberschriften -->
        <Style x:Key="IconTileStyle" TargetType="Border">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource AppIconCircleBackground}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>
        <Style x:Key="IconTileGlyphStyle" TargetType="TextBlock" BasedOn="{StaticResource GlyphStyle}">
            <Setter Property="Foreground" Value="{DynamicResource AppIconForeground}"/>
        </Style>
        <Style x:Key="DividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="Margin" Value="0,16,0,16"/>
        </Style>
        <!-- Einstellungszeile: Text links, Schalter rechts (wie Windows-Einstellungen) -->
        <Style x:Key="SettingRowStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ChipBackground}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- ============================================================
           Knöpfe
           ============================================================ -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="ToolbarAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

        <!-- ============================================================
           Eingaben
           ============================================================ -->
        <ControlTemplate x:Key="InputTemplate" TargetType="{x:Type Control}">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    SnapsToDevicePixels="True">
                <ScrollViewer x:Name="PART_ContentHost"
                              Margin="{TemplateBinding Padding}"
                              Focusable="False"
                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ScrollBarThumbHoverBackground}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}"/>
                    <Setter TargetName="Bd" Property="BorderThickness" Value="1,1,1,2"/>
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackground}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ChipBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextMain}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentButtonBackground}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template" Value="{StaticResource InputTemplate}"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource ChipBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextMain}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentButtonBackground}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template" Value="{StaticResource InputTemplate}"/>
        </Style>

        <!-- Schalter ohne eigene Beschriftung – der Text steht in der Einstellungszeile. -->
        <Style x:Key="SwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="Track" Width="44" Height="22" CornerRadius="11"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource TextMuted}" BorderThickness="1.5">
                                <Ellipse x:Name="Thumb" Width="12" Height="12"
                                         Fill="{DynamicResource TextMuted}"
                                         HorizontalAlignment="Left" Margin="4,0,0,0"
                                         VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Width" Value="14"/>
                                <Setter TargetName="Thumb" Property="Height" Value="14"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentButtonBackground}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource AccentButtonForeground}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Aufklappbereich mit Chevron. Wird auch vom Code für Detailtexte benutzt. -->
        <Style x:Key="ExpanderHeaderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                <TextBlock x:Name="Chevron" Grid.Column="1" Text="&#xE70D;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" Margin="12,0,2,0"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChipBackground}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernExpanderStyle" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Top"
                                          Style="{StaticResource ExpanderHeaderToggleStyle}"
                                          Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontSize="{TemplateBinding FontSize}"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Focusable="False"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Expander" BasedOn="{StaticResource ModernExpanderStyle}"/>

        <!-- ============================================================
           Navigation und Auswahllisten
           ============================================================ -->
        <Style x:Key="NavStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="Margin" Value="0,1,0,1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <Border x:Name="Row" CornerRadius="8" Background="Transparent"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                        </Border>
                                        <!-- Auswahlbalken links, wie in der Windows-Navigation -->
                                        <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="1.5"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{DynamicResource AccentButtonBackground}"
                                                Visibility="Hidden"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource ChipBackground}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource ChipBackground}"/>
                                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}"/>
                                            <Setter TargetName="Row" Property="BorderThickness" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Karten- und Terminalliste: größere Zeilen mit Rand bei Auswahl -->
        <Style x:Key="SelectListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,11"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" CornerRadius="12"
                                            Background="Transparent"
                                            BorderBrush="Transparent" BorderThickness="1"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource ChipBackground}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource ChipBackground}"/>
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Reiter tragen nur den Inhalt, die Köpfe zeichnet die Navigationsleiste. -->
        <Style x:Key="HiddenTabHostStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <WrapPanel IsItemsHost="True" Visibility="Collapsed"/>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CountBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppIconCircleBackground}"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="MinWidth" Value="22"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="CountBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppIconForeground}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======================= Kopf: Zustand ======================= -->
        <Border x:Name="StatusBanner"
                Grid.Row="0"
                CornerRadius="20"
                Padding="24,20,24,20"
                Margin="0,0,0,18"
                BorderThickness="1"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderSubtle}"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="StatusIconCircle"
                            Width="56" Height="56"
                            CornerRadius="18"
                            Background="{DynamicResource StatusEmpty}"
                            VerticalAlignment="Center"
                            Margin="0,0,18,0">
                        <local:AppIcon x:Name="StatusGlyph"
                                       Glyph="&#xE703;"
                                       Size="28"
                                       StrokeThickness="2.4"
                                       Stroke="White"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <local:AppIcon Glyph="&#xE703;" Style="{StaticResource IconStyle}" Size="11"
                                       Stroke="{DynamicResource TextMuted}" Margin="0,0,6,0"/>
                            <TextBlock Text="Konnektor" Style="{StaticResource EyebrowStyle}"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusTitle"
                                   Text="Noch nicht verbunden"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMain}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,3,0,0"/>
                        <TextBlock x:Name="StatusDetail"
                                   Text="Zugangsdaten eintragen und „Speichern &amp; verbinden“ wählen."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextMuted}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button x:Name="CopyReportButton" Click="CopyReport_Click"
                                Style="{StaticResource ToolbarButtonStyle}"
                                AutomationProperties.Name="Bericht"
                                ToolTip="Diagnosebericht in die Zwischenablage kopieren">
                            <StackPanel Orientation="Horizontal">
                                <local:AppIcon Glyph="&#xE8C8;" Style="{StaticResource IconStyle}" Size="14" Margin="0,0,8,0"
                                           Stroke="{DynamicResource ButtonForeground}"/>
                                <TextBlock Text="Bericht"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="RefreshButton" Click="Refresh_Click"
                                Style="{StaticResource ToolbarAccentButtonStyle}"
                                AutomationProperties.Name="Aktualisieren" IsDefault="False">
                            <StackPanel Orientation="Horizontal">
                                <local:AppIcon Glyph="&#xE72C;" Style="{StaticResource IconStyle}" Size="14" Margin="0,0,8,0"
                                           Stroke="{DynamicResource AccentButtonForeground}"/>
                                <TextBlock Text="Aktualisieren"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Kennzahlen: gleich breite Kacheln. Werden vom Code gefüllt. -->
                <UniformGrid x:Name="StatusChips" Grid.Row="1" Rows="1" Margin="0,18,-10,0"/>
            </Grid>
        </Border>

        <!-- ================= Navigationsleiste + Seiten ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Padding="10,14" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Bereiche" Style="{StaticResource EyebrowStyle}" Margin="12,0,0,8"/>
                    <!-- Die Auswahl hier ist dieselbe wie die der Reiter (Tabs.SelectedIndex). -->
                    <ListBox x:Name="Nav" Style="{StaticResource NavStyle}"
                             SelectionChanged="Nav_SelectionChanged"
                             KeyboardNavigation.TabNavigation="Once"
                             KeyboardNavigation.DirectionalNavigation="Contained"
                             AutomationProperties.Name="Konnektor-Bereiche">
                        <ListBoxItem x:Name="NavOverview" AutomationProperties.Name="Übersicht">
                            <DockPanel>
                                <local:AppIcon Style="{StaticResource NavPathIconStyle}" Glyph="&#xE80F;"/>
                                <TextBlock Text="Übersicht" VerticalAlignment="Center"/>
                            </DockPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavCards" AutomationProperties.Name="Karten">
                            <DockPanel>
                                <local:AppIcon Style="{StaticResource NavPathIconStyle}" Glyph="&#xE8C7;"/>
                                <Border x:Name="NavCardsBadge" DockPanel.Dock="Right" Style="{StaticResource CountBadgeStyle}">
                                    <TextBlock x:Name="NavCardsCount" Text="" Style="{StaticResource CountBadgeTextStyle}"/>
                                </Border>
                                <TextBlock Text="Karten" VerticalAlignment="Center"/>
                            </DockPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavTerminals" AutomationProperties.Name="Terminals">
                            <DockPanel>
                                <local:AppIcon Style="{StaticResource NavPathIconStyle}" Glyph="&#xE7F4;"/>
                                <Border x:Name="NavTerminalsBadge" DockPanel.Dock="Right" Style="{StaticResource CountBadgeStyle}">
                                    <TextBlock x:Name="NavTerminalsCount" Text="" Style="{StaticResource CountBadgeTextStyle}"/>
                                </Border>
                                <TextBlock Text="Terminals" VerticalAlignment="Center"/>
                            </DockPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavCertificates" AutomationProperties.Name="Zertifikate">
                            <DockPanel>
                                <local:AppIcon Style="{StaticResource NavPathIconStyle}" Glyph="&#xEB95;"/>
                                <TextBlock Text="Zertifikate" VerticalAlignment="Center"/>
                            </DockPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavEvents" AutomationProperties.Name="Ereignisse">
                            <DockPanel>
                                <local:AppIcon Style="{StaticResource NavPathIconStyle}" Glyph="&#xEA8F;"/>
                                <TextBlock Text="Ereignisse" VerticalAlignment="Center"/>
                            </DockPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavHistory" AutomationProperties.Name="Verlauf">
                            <DockPanel>
                                <local:AppIcon Style="{StaticResource NavPathIconStyle}" Glyph="&#xE81C;"/>
                                <TextBlock Text="Verlauf" VerticalAlignment="Center"/>
                            </DockPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavDiagnostics" AutomationProperties.Name="Diagnose">
                            <DockPanel>
                                <local:AppIcon Style="{StaticResource NavPathIconStyle}" Glyph="&#xE9D9;"/>
                                <TextBlock Text="Diagnose" VerticalAlignment="Center"/>
                            </DockPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavConnection" AutomationProperties.Name="Verbindung">
                            <DockPanel>
                                <local:AppIcon Style="{StaticResource NavPathIconStyle}" Glyph="&#xE713;"/>
                                <TextBlock Text="Verbindung" VerticalAlignment="Center"/>
                            </DockPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <TabControl x:Name="Tabs" Grid.Column="2" Style="{StaticResource HiddenTabHostStyle}">

            <!-- ============================ Übersicht ============================ -->
            <TabItem Header="Übersicht">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Übersicht" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Zustand, gesteckte Karte und Eckdaten des Konnektors auf einen Blick." Style="{StaticResource PageHintStyle}"/>

                        <Border x:Name="AlertsCard" Style="{StaticResource PanelStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <Border Style="{StaticResource IconTileStyle}" Background="{DynamicResource StatusPartialSurface}">
                                        <local:AppIcon Glyph="&#xE7BA;" Style="{StaticResource IconStyle}" Stroke="{DynamicResource StatusPartial}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Hinweise" Style="{StaticResource SectionTitleStyle}"/>
                                    </StackPanel>
                                </DockPanel>
                                <StackPanel x:Name="AlertsPanel"/>
                            </StackPanel>
                        </Border>

                        <!-- Gesteckte Karte: eine Zeile, die sich liest wie ein Satz ("SMC-B gesteckt") -->
                        <Border x:Name="PresenceCard" Style="{StaticResource PanelStyle}" Padding="20,16" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="PresenceTile" Width="44" Height="44" CornerRadius="12" Margin="0,0,16,0"
                                        BorderThickness="1"
                                        Background="{DynamicResource ChipBackground}" VerticalAlignment="Center">
                                    <local:AppIcon x:Name="PresenceIcon" Glyph="&#xE8C7;" Size="22"
                                                   Stroke="{DynamicResource TextMuted}"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="PresenceEyebrow" Text="Gesteckte Karte" Style="{StaticResource EyebrowStyle}"/>
                                    <TextBlock x:Name="PresenceState" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextMain}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="PresenceDetail" FontSize="12"
                                               Foreground="{DynamicResource TextMuted}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <TextBlock x:Name="PresenceAge" FontSize="12" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextMain}"/>
                                    <TextBlock x:Name="PresenceSource" FontSize="11" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Letzte 24 Stunden: je Zeile 24 Stundenbalken -->
                        <Border x:Name="Last24Card" Style="{StaticResource PanelStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock x:Name="Last24Availability" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource TextMain}"/>
                                        <TextBlock Text="erreichbar" FontSize="11" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>
                                    <Border Style="{StaticResource IconTileStyle}">
                                        <local:AppIcon Glyph="&#xE81C;" Style="{StaticResource IconTileIconStyle}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Letzte 24 Stunden" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="Je Balken eine Stunde – grün in Ordnung, gelb zeitweise, rot gestört." Style="{StaticResource SectionHintStyle}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Grid x:Name="Last24Grid"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ConnectorInfoCard" Style="{StaticResource PanelStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <Border Style="{StaticResource IconTileStyle}">
                                        <local:AppIcon Glyph="&#xE950;" Style="{StaticResource IconTileIconStyle}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Konnektor" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="Aus connector.sds und GetResourceInformation" Style="{StaticResource SectionHintStyle}"/>
                                    </StackPanel>
                                </DockPanel>
                                <WrapPanel x:Name="ConnectorInfoGrid" ItemWidth="262" Margin="0,0,-10,-10"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Karten ============================== -->
            <TabItem x:Name="CardsTab" Header="Karten">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Karten" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="SMC-B, HBA und eGK – PIN-Zustand, Zertifikate und Aktionen." Style="{StaticResource PageHintStyle}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Padding="10,14">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="10,0,8,10">
                                    <TextBlock x:Name="CardsCountText" DockPanel.Dock="Right" Text="" FontSize="12"
                                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Gesteckte Karten" Style="{StaticResource EyebrowStyle}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ListBox x:Name="CardsList" Style="{StaticResource SelectListStyle}"
                                         SelectionChanged="CardsList_SelectionChanged"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" x:Name="CardsCard" Style="{StaticResource PanelStyle}" Padding="24,22">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="CardDetailPanel"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ============================ Terminals ============================ -->
            <TabItem x:Name="TerminalsTab" Header="Terminals">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Terminals" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Kartenterminals, ihre Verbindung und die gesteckten Karten." Style="{StaticResource PageHintStyle}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Padding="10,14">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="10,0,8,10">
                                    <TextBlock x:Name="TerminalsCountText" DockPanel.Dock="Right" Text="" FontSize="12"
                                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Kartenterminals" Style="{StaticResource EyebrowStyle}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ListBox x:Name="TerminalsList" Style="{StaticResource SelectListStyle}"
                                         SelectionChanged="TerminalsList_SelectionChanged"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" x:Name="TerminalsCard" Style="{StaticResource PanelStyle}" Padding="24,22">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="TerminalDetailPanel"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ============================ Zertifikate ============================ -->
            <TabItem Header="Zertifikate">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" x:Name="ExportCalendarButton" Click="ExportCalendar_Click"
                                    VerticalAlignment="Top" Margin="16,2,0,0" Padding="14,9"
                                    ToolTip="Alle Zertifikatsabläufe als Kalenderdatei (.ics) für Outlook bzw. den Kalender speichern – mit Erinnerungen 90, 30 und 7 Tage vorher">
                                <StackPanel Orientation="Horizontal">
                                    <local:AppIcon Glyph="&#xE787;" Style="{StaticResource IconStyle}" Size="14" Margin="0,0,8,0"
                                               Stroke="{DynamicResource ButtonForeground}"/>
                                    <TextBlock Text="Ablaufkalender (.ics)"/>
                                </StackPanel>
                            </Button>
                            <StackPanel>
                                <TextBlock Text="Zertifikate" Style="{StaticResource PageTitleStyle}"/>
                                <TextBlock Text="Ablauf von SMC-B, HBA und gSMC-KT (Kartenterminal) sowie des Clientsystem-Zertifikats. Warnstufen: 90, 30 und 7 Tage vor Ablauf."
                                           Style="{StaticResource PageHintStyle}"/>
                            </StackPanel>
                        </DockPanel>
                        <WrapPanel x:Name="CertificatesPanel" ItemWidth="300" Margin="0,0,-14,0"/>
                        <Border x:Name="CertificatesEmpty" Style="{StaticResource PanelStyle}" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ Ereignisse ============================ -->
            <TabItem Header="Ereignisse">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Ereignisse" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Karte ein/aus und Terminals werden über CETP gemeldet, sobald ein Abo steht."
                                   Style="{StaticResource PageHintStyle}"/>

                        <Border x:Name="EventsPresenceCard" Style="{StaticResource PanelStyle}">
                            <DockPanel>
                                <Border Style="{StaticResource IconTileStyle}">
                                    <local:AppIcon Glyph="&#xEA8F;" Style="{StaticResource IconTileIconStyle}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Live-Ereignisse" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock x:Name="EventsPresenceSummary" FontSize="13" Foreground="{DynamicResource TextMain}"
                                               TextWrapping="Wrap" Margin="0,6,0,0"
                                               Text="Noch keine Ereignisse empfangen."/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Aktive Abos: zeigt, ob überhaupt etwas abonniert ist. -->
                        <Border Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <DockPanel>
                                    <Border Style="{StaticResource IconTileStyle}">
                                        <local:AppIcon Glyph="&#xE8F1;" Style="{StaticResource IconTileIconStyle}"/>
                                    </Border>
                                    <Button DockPanel.Dock="Right" x:Name="UnsubscribeButton"
                                            Padding="13,8" VerticalAlignment="Top" Margin="12,0,0,0"
                                            Click="Unsubscribe_Click"
                                            ToolTip="Entfernt alle Einträge, die auf diesem Rechner zeigen. Hilft, wenn derselbe Lauscher nach Fehlversuchen mehrfach steht.">
                                        <StackPanel Orientation="Horizontal">
                                            <local:AppIcon Glyph="&#xE74D;" Style="{StaticResource IconStyle}" Size="13" Margin="0,0,8,0"
                                                       Stroke="{DynamicResource ButtonForeground}"/>
                                            <TextBlock Text="Abos dieser App kündigen"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Ereignis-Abos" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="Was der Konnektor derzeit an diese App meldet. Leere Liste heißt: es wird nur gepollt."
                                                   Style="{StaticResource SectionHintStyle}"/>
                                    </StackPanel>
                                </DockPanel>
                                <ItemsControl x:Name="SubscriptionsList" Margin="0,16,0,0"/>
                                <Border Background="{DynamicResource ChipBackground}" CornerRadius="10" Padding="14,10" Margin="0,8,0,0">
                                    <DockPanel>
                                        <local:AppIcon Glyph="&#xE946;" Style="{StaticResource IconStyle}" Size="13"
                                                   Stroke="{DynamicResource TextMuted}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                                        <TextBlock x:Name="SubscriptionsStatus" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMuted}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Verlauf ============================== -->
            <TabItem x:Name="HistoryTab" Header="Verlauf">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Konnektor-Verlauf (14 Tage)" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Erreichbarkeit, VPN zur TI und zum SIS sowie gesteckte Karten – lokal aufgezeichnet bei jedem Abruf. Kachel anklicken für die Stunden."
                                   Style="{StaticResource PageHintStyle}"/>
                        <Border Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <Border Style="{StaticResource IconTileStyle}">
                                        <local:AppIcon Glyph="&#xE787;" Style="{StaticResource IconTileIconStyle}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Tage" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock x:Name="HistorySummary" Style="{StaticResource SectionHintStyle}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Grid x:Name="HistoryGrid"/>
                                <WrapPanel x:Name="HistoryLegend" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <Border Style="{StaticResource IconTileStyle}">
                                        <local:AppIcon Glyph="&#xE823;" Style="{StaticResource IconTileIconStyle}"/>
                                    </Border>
                                    <TextBlock x:Name="HistoryDayTitle" Text="Stunden" Style="{StaticResource SectionTitleStyle}"/>
                                </DockPanel>
                                <Grid x:Name="HistoryHoursGrid"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="HistoryEmpty" Style="{StaticResource PanelStyle}" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Diagnose ============================== -->
            <TabItem x:Name="DiagnosticsTab" Header="Diagnose">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Diagnose" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Dienstverzeichnis des Konnektors und Protokoll des letzten Abrufs." Style="{StaticResource PageHintStyle}"/>

                        <!-- Erklaerung zu einer angeklickten Kennzahl aus dem Kopf -->
                        <Border x:Name="ExplainCard" Style="{StaticResource PanelStyle}" Visibility="Collapsed">
                            <StackPanel x:Name="ExplainPanel"/>
                        </Border>

                        <Border x:Name="ServicesCard" Style="{StaticResource PanelStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <Border Style="{StaticResource IconTileStyle}">
                                        <local:AppIcon Glyph="&#xE71D;" Style="{StaticResource IconTileIconStyle}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Dienstverzeichnis" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="Aus connector.sds – Name, Version und Erreichbarkeit der angebotenen Dienste"
                                                   Style="{StaticResource SectionHintStyle}"/>
                                    </StackPanel>
                                </DockPanel>
                                <StackPanel x:Name="ServicesPanel"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelStyle}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                    <Border Style="{StaticResource IconTileStyle}">
                                        <local:AppIcon Glyph="&#xE756;" Style="{StaticResource IconTileIconStyle}"/>
                                    </Border>
                                    <TextBlock Text="Ablauf des letzten Abrufs" Style="{StaticResource SectionTitleStyle}"/>
                                </DockPanel>
                                <TextBox x:Name="LogBox"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         MinHeight="300"
                                         Padding="12,10"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Cascadia Mono, Consolas"
                                         FontSize="11.5"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================= Verbindung ============================= -->
            <TabItem x:Name="ConnectionTab" Header="Verbindung">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Verbindung" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Werte aus der Konnektor-Administration. Das Client-Zertifikat (.p12) wird im Konnektor für dieses Clientsystem erzeugt bzw. hinterlegt."
                                   Style="{StaticResource PageHintStyle}"/>

                        <!-- Zugang und Aufrufkontext: immer offen, nicht mehr einklappbar. -->
                        <StackPanel x:Name="ConnectionSection">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <local:AppIcon Glyph="&#xE72E;" Style="{StaticResource IconStyle}" Size="15"
                                               Stroke="{DynamicResource AppIconForeground}" Margin="0,0,10,0"/>
                                <TextBlock Text="Zugang und Aufrufkontext" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMain}"/>
                            </StackPanel>
                            <StackPanel Margin="0,12,0,0">

                                <!-- == Zugang == -->
                                <Border Style="{StaticResource PanelStyle}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,18">
                                            <Border Style="{StaticResource IconTileStyle}">
                                                <local:AppIcon Glyph="&#xE774;" Style="{StaticResource IconTileIconStyle}"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Zugang" Style="{StaticResource SectionTitleStyle}"/>
                                                <TextBlock Text="Adresse des Konnektors und Client-Zertifikat dieses Arbeitsplatzes." Style="{StaticResource SectionHintStyle}"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,0,14">
                                                <TextBlock Text="Konnektor-Adresse" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox x:Name="HostBox"
                                                         ToolTip="IP oder Hostname, optional mit Port, z. B. 192.168.1.10 oder 10.0.0.5:8443"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="0,0,0,14">
                                                <TextBlock Text="Übertragung" Style="{StaticResource FieldLabelStyle}"/>
                                                <StackPanel Orientation="Horizontal" Height="36">
                                                    <CheckBox x:Name="UseTlsToggle" Style="{StaticResource SwitchStyle}"
                                                              AutomationProperties.Name="TLS (https)"/>
                                                    <TextBlock Text="TLS (https)" FontSize="13" Foreground="{DynamicResource TextMain}"
                                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Text="Client-Zertifikat (.p12)" Style="{StaticResource FieldLabelStyle}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="CertPathBox"/>
                                                <Button Grid.Column="1" Click="BrowseCertificate_Click" Margin="8,0,0,0" Padding="13,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <local:AppIcon Glyph="&#xE838;" Style="{StaticResource IconStyle}" Size="13" Margin="0,0,8,0"
                                                                   Stroke="{DynamicResource ButtonForeground}"/>
                                                        <TextBlock Text="Durchsuchen…"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <TextBlock x:Name="CertPasswordHint" Text="" FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}" Margin="0,5,0,0"/>
                                        </StackPanel>

                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="Passwort" Style="{StaticResource FieldLabelStyle}"/>
                                            <PasswordBox x:Name="CertPasswordBox"
                                                         ToolTip="Leer lassen, um das gespeicherte Passwort zu behalten"/>
                                            <CheckBox x:Name="ClearCertPasswordToggle" Content="Gespeichertes Passwort entfernen"
                                                      Style="{DynamicResource ThemeAwareCheckBoxStyle}" Margin="0,10,0,0"/>
                                        </StackPanel>

                                        <Border Background="{DynamicResource ChipBackground}" CornerRadius="10" Padding="14,10" Margin="0,12,0,0">
                                            <DockPanel>
                                                <local:AppIcon Glyph="&#xEB95;" Style="{StaticResource IconStyle}" Size="14"
                                                           Stroke="{DynamicResource TextMuted}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                                                <TextBlock x:Name="ClientCertInfo" Text="Noch kein Client-Zertifikat geladen."
                                                           FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextMuted}"/>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- == Aufrufkontext == -->
                                <Border Style="{StaticResource PanelStyle}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,18">
                                            <Border Style="{StaticResource IconTileStyle}">
                                                <local:AppIcon Glyph="&#xE77B;" Style="{StaticResource IconTileIconStyle}"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Aufrufkontext" Style="{StaticResource SectionTitleStyle}"/>
                                                <TextBlock Text="Genau die Werte aus der Konnektor-Administration verwenden. Erlaubt sind A-Z, a-z, 0-9, - und _, 1–64 Zeichen."
                                                           Style="{StaticResource SectionHintStyle}"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                                <TextBlock Text="Mandant-ID" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox x:Name="MandantBox"
                                                         ToolTip="Nur A-Z, a-z, 0-9, - und _. Punkte oder Leerzeichen quittieren viele Konnektoren mit 4000 Syntaxfehler"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                                <TextBlock Text="Clientsystem-ID" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox x:Name="ClientSystemBox"
                                                         ToolTip="Wie in der Konnektor-Administration hinterlegt"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0">
                                                <TextBlock Text="Arbeitsplatz-ID" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox x:Name="WorkplaceBox"
                                                         ToolTip="Wie in der Konnektor-Administration hinterlegt"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2">
                                                <TextBlock Text="Benutzer-ID (für HBA)" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox x:Name="UserBox"
                                                         ToolTip="Frei wählbare Kennung des Benutzers, z. B. das Kürzel des HBA-Inhabers. Wird nicht im Konnektor angelegt."/>
                                                <TextBlock Text="Frei wählbar (z. B. Kürzel des Arztes). Nötig, wenn der Konnektor bei HBA-Abfragen Fehler 4003 meldet."
                                                           Style="{StaticResource SectionHintStyle}" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- == Home Assistant == -->
                                <Border Style="{StaticResource PanelStyle}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,16">
                                            <CheckBox x:Name="HaEnabledToggle" DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}"
                                                      Checked="HaEnabled_Changed" Unchecked="HaEnabled_Changed"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.Name="An Home Assistant senden"/>
                                            <Border Style="{StaticResource IconTileStyle}">
                                                <local:AppIcon x:Name="HaIcon" Glyph="home" Style="{StaticResource IconTileIconStyle}"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Home Assistant" Style="{StaticResource SectionTitleStyle}"/>
                                                <TextBlock Text="Schickt nach jedem Abruf Erreichbarkeit, VPN TI/SIS, Live-Ereignisse, Karten, Terminals und die Restlaufzeit von SMC-B, HBA, gSMC-KT und Clientsystem-Zertifikat als Sensoren an Home Assistant."
                                                           Style="{StaticResource SectionHintStyle}"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <!-- Weg: REST-API (Token) oder MQTT (Gerät je Praxis, Last Will) -->
                                        <Border Background="{DynamicResource ChipBackground}" CornerRadius="9" Padding="3"
                                                HorizontalAlignment="Left" Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="HaRestRadio" GroupName="HaTransport" Style="{StaticResource SegmentStyle}"
                                                             Content="REST-API" Checked="HaTransport_Changed"/>
                                                <RadioButton x:Name="HaMqttRadio" GroupName="HaTransport" Style="{StaticResource SegmentStyle}"
                                                             Content="MQTT (empfohlen)" Checked="HaTransport_Changed"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="HaTransportHint" Style="{StaticResource SectionHintStyle}" Margin="0,0,0,14"/>

                                        <!-- REST -->
                                        <Grid x:Name="HaRestPanel">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,0,14">
                                                <TextBlock Text="Adresse" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox x:Name="HaUrlBox"
                                                         ToolTip="z. B. http://homeassistant.local:8123 oder https://…ui.nabu.casa"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="0,0,0,14">
                                                <DockPanel>
                                                    <TextBlock x:Name="HaTokenHint" DockPanel.Dock="Right" FontSize="11"
                                                               Foreground="{DynamicResource TextMuted}"/>
                                                    <TextBlock Text="Long-Lived Access Token" Style="{StaticResource FieldLabelStyle}"/>
                                                </DockPanel>
                                                <PasswordBox x:Name="HaTokenBox"
                                                             ToolTip="Home Assistant → Profil → Sicherheit → Langlebige Zugriffstoken. Leer lassen, um das gespeicherte zu behalten."/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- MQTT -->
                                        <Grid x:Name="HaMqttPanel" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                                <TextBlock Text="MQTT-Broker" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox x:Name="MqttHostBox"
                                                         ToolTip="Hostname oder IP des Brokers, z. B. homeassistant.local (Mosquitto-Add-on)"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                                <TextBlock Text="Port" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox x:Name="MqttPortBox" ToolTip="1883, mit TLS meist 8883"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,14" VerticalAlignment="Bottom">
                                                <CheckBox x:Name="MqttTlsToggle" Content="TLS" Style="{DynamicResource ThemeAwareCheckBoxStyle}"
                                                          Margin="0,0,0,6"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                                                <TextBlock Text="Benutzer" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox x:Name="MqttUserBox" ToolTip="Ein Home-Assistant-Benutzer oder ein Benutzer des Mosquitto-Add-ons"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Margin="0,0,0,14">
                                                <DockPanel>
                                                    <TextBlock x:Name="MqttPasswordHint" DockPanel.Dock="Right" FontSize="11"
                                                               Foreground="{DynamicResource TextMuted}"/>
                                                    <TextBlock Text="Passwort" Style="{StaticResource FieldLabelStyle}"/>
                                                </DockPanel>
                                                <PasswordBox x:Name="MqttPasswordBox"
                                                             ToolTip="Leer lassen, um das gespeicherte Passwort zu behalten"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Name der Praxis" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBox x:Name="HaNameBox" TextChanged="HaNameBox_TextChanged"
                                                         ToolTip="Unterscheidet mehrere Konnektoren in Home Assistant. Leer: Inhaber der SMC-B."/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Entitäten" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBlock x:Name="HaEntityPreview" Style="{StaticResource MonoStyle}" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <DockPanel Margin="0,16,0,0">
                                            <Button x:Name="HaTestButton" DockPanel.Dock="Right" Click="HaTest_Click" Padding="14,8"
                                                    AutomationProperties.Name="Home Assistant testen">
                                                <StackPanel Orientation="Horizontal">
                                                    <local:AppIcon Glyph="&#xE9D5;" Style="{StaticResource IconStyle}" Size="14" Margin="0,0,9,0"
                                                                   Stroke="{DynamicResource ButtonForeground}"/>
                                                    <TextBlock Text="Verbindung testen"/>
                                                </StackPanel>
                                            </Button>
                                            <Ellipse x:Name="HaStatusDot" Width="8" Height="8" Margin="2,0,10,0" VerticalAlignment="Center"
                                                     Fill="{DynamicResource StatusEmpty}"/>
                                            <TextBlock x:Name="HaStatusText" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextMuted}" Margin="0,0,16,0"
                                                       Text="Noch nichts gesendet."/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- == Verhalten == -->
                                <Border Style="{StaticResource PanelStyle}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,16">
                                            <Border Style="{StaticResource IconTileStyle}">
                                                <local:AppIcon Glyph="&#xE9E9;" Style="{StaticResource IconTileIconStyle}"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Verhalten" Style="{StaticResource SectionTitleStyle}"/>
                                                <TextBlock Text="Wie oft abgefragt wird und was die App im Hintergrund tut." Style="{StaticResource SectionHintStyle}"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <Border Style="{StaticResource SettingRowStyle}">
                                            <DockPanel>
                                                <CheckBox x:Name="EnabledToggle" DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}"
                                                          AutomationProperties.Name="Konnektor-Anbindung aktiv"/>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Text="Konnektor-Anbindung aktiv" FontSize="13" Foreground="{DynamicResource TextMain}"/>
                                                    <TextBlock Text="Schaltet Abruf und Anzeige des Konnektors ein." Style="{StaticResource SectionHintStyle}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingRowStyle}">
                                            <DockPanel>
                                                <CheckBox x:Name="MonitoringToggle" DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}"
                                                          AutomationProperties.Name="Im Hintergrund überwachen (Toasts)"/>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Text="Im Hintergrund überwachen (Toasts)" FontSize="13" Foreground="{DynamicResource TextMain}"/>
                                                    <TextBlock Text="Meldet Störungen auch bei geschlossenem Fenster." Style="{StaticResource SectionHintStyle}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingRowStyle}">
                                            <DockPanel>
                                                <CheckBox x:Name="EventSubscriptionsToggle" DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}"
                                                          AutomationProperties.Name="Ereignis-Abos (Karte rein/raus sofort)"/>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Text="Ereignis-Abos (Karte rein/raus sofort)" FontSize="13" Foreground="{DynamicResource TextMain}"/>
                                                    <TextBlock Text="Die App lauscht auf einem lokalen TCP-Port. Schlägt das Abo fehl, wird automatisch weiter gepollt."
                                                               Style="{StaticResource SectionHintStyle}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingRowStyle}">
                                            <DockPanel>
                                                <CheckBox x:Name="HistoryToggle" DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}"
                                                          AutomationProperties.Name="Verlauf lokal speichern (14 Tage)"/>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Text="Verlauf lokal speichern (14 Tage)" FontSize="13" Foreground="{DynamicResource TextMain}"/>
                                                    <TextBlock Text="Für Timeline und Störungsdauer – auch wenn die gematik-API nicht erreichbar ist"
                                                               Style="{StaticResource SectionHintStyle}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingRowStyle}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBox x:Name="PollMinutesBox" Width="64" TextAlignment="Center"/>
                                                    <TextBlock Text="Min." FontSize="12" Foreground="{DynamicResource TextMuted}"
                                                               Margin="8,0,0,0" VerticalAlignment="Center" Width="34"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Intervall" FontSize="13" Foreground="{DynamicResource TextMain}"/>
                                                    <TextBlock Text="Abstand zwischen zwei Abrufen im Hintergrund." Style="{StaticResource SectionHintStyle}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingRowStyle}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBox x:Name="CertWarnDaysBox" Width="64" TextAlignment="Center"/>
                                                    <TextBlock Text="Tage" FontSize="12" Foreground="{DynamicResource TextMuted}"
                                                               Margin="8,0,0,0" VerticalAlignment="Center" Width="34"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Warnung ab" FontSize="13" Foreground="{DynamicResource TextMain}"/>
                                                    <TextBlock Text="Ab wie vielen Resttagen ein Zertifikat als bald ablaufend gilt." Style="{StaticResource SectionHintStyle}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <TextBlock x:Name="EventStreamInfo" Text="" FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="4,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- == Erweitert == -->
                                <Border Style="{StaticResource PanelStyle}" Padding="12,10">
                                    <Expander Padding="10,8">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <local:AppIcon Glyph="&#xE90F;" Style="{StaticResource IconStyle}" Size="14"
                                                           Stroke="{DynamicResource TextMuted}" Margin="0,0,10,0"/>
                                                <TextBlock Text="Erweitert" FontSize="14" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="10,14,10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,0,14">
                                                    <TextBlock Text="Basic-Auth Benutzer" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBox x:Name="BasicUserBox"
                                                             ToolTip="Nur, wenn der Konnektor Benutzer/Passwort statt eines Zertifikats verlangt"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="0,0,0,14">
                                                    <TextBlock Text="Basic-Auth Passwort" Style="{StaticResource FieldLabelStyle}"/>
                                                    <PasswordBox x:Name="BasicPasswordBox"
                                                                 ToolTip="Leer lassen, um das gespeicherte Passwort zu behalten"/>
                                                    <CheckBox x:Name="ClearBasicPasswordToggle" Content="Gespeichertes Passwort entfernen"
                                                              Style="{DynamicResource ThemeAwareCheckBoxStyle}" Margin="0,10,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <Border Style="{StaticResource SettingRowStyle}">
                                                <DockPanel>
                                                    <CheckBox x:Name="RewriteHostToggle" DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}"
                                                              AutomationProperties.Name="Dienst-Endpunkte auf diese Adresse umleiten (empfohlen)"/>
                                                    <StackPanel Margin="0,0,16,0">
                                                        <TextBlock Text="Dienst-Endpunkte auf diese Adresse umleiten (empfohlen)" FontSize="13"
                                                                   Foreground="{DynamicResource TextMain}" TextWrapping="Wrap"/>
                                                        <TextBlock Text="connector.sds enthält oft interne Hostnamen, die vom Arbeitsplatz nicht auflösbar sind"
                                                                   Style="{StaticResource SectionHintStyle}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>

                                            <Border Style="{StaticResource SettingRowStyle}" Margin="0,0,0,0">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Click="ResetTrust_Click" Padding="13,7" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <local:AppIcon Glyph="&#xE777;" Style="{StaticResource IconStyle}" Size="13" Margin="0,0,8,0"
                                                                       Stroke="{DynamicResource ButtonForeground}"/>
                                                            <TextBlock Text="Vertrauen zurücksetzen"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Gepinntes TLS-Zertifikat" FontSize="13" Foreground="{DynamicResource TextMain}"/>
                                                        <TextBlock x:Name="PinnedThumbprintText" Text="nicht gepinnt"
                                                                   Style="{StaticResource MonoStyle}" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <!-- == Aktionen == -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                    <Button x:Name="SaveConnectButton"
                                            Style="{StaticResource AccentButtonStyle}" Padding="20,11" Margin="0,0,10,0"
                                            Click="SaveConnect_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <local:AppIcon Glyph="&#xE74E;" Style="{StaticResource IconStyle}" Size="14" Margin="0,0,9,0"
                                                       Stroke="{DynamicResource AccentButtonForeground}"/>
                                            <TextBlock Text="Speichern &amp; verbinden"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TestButton" Padding="20,11" Click="Test_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <local:AppIcon Glyph="&#xE9D5;" Style="{StaticResource IconStyle}" Size="14" Margin="0,0,9,0"
                                                       Stroke="{DynamicResource ButtonForeground}"/>
                                            <TextBlock Text="Nur testen"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            </TabControl>
        </Grid>

        <!-- ========================= Ladeanzeige ========================= -->
        <Border x:Name="BusyOverlay" Grid.Row="0" Grid.RowSpan="3" Margin="-24,-20,-24,-14"
                Visibility="Collapsed" Background="#73000000" Panel.ZIndex="20"
                AutomationProperties.LiveSetting="Assertive">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource PanelStyle}" MinWidth="340" MaxWidth="460" Margin="0" Padding="32,28">
                <StackPanel>
                    <!-- Drehender Ring -->
                    <Grid Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Ellipse Stroke="{DynamicResource ChipBackground}" StrokeThickness="4"/>
                        <Path Stroke="{DynamicResource AccentButtonBackground}" StrokeThickness="4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 22,2 A 20,20 0 0 1 42,22" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotation" Angle="0"/>
                            </Path.RenderTransform>
                            <Path.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:0.9"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Path.Triggers>
                        </Path>
                    </Grid>
                    <TextBlock x:Name="BusyOverlayTitle" Text="Bitte warten …"
                               FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="BusyOverlayText" Text=""
                               FontSize="13" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- ============================ Statusleiste ============================ -->
        <Grid Grid.Row="2" Margin="2,14,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <local:AppIcon Glyph="&#xE823;" Style="{StaticResource IconStyle}" Size="12"
                           Stroke="{DynamicResource TextMuted}" Margin="0,0,8,0"/>
                <TextBlock x:Name="FooterText" Text="" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" FontSize="12"/>
            </StackPanel>
            <Button Content="Schließen" HorizontalAlignment="Right" MinWidth="110" Click="Close_Click" Padding="16,8"
                    AutomationProperties.Name="Schließen" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
