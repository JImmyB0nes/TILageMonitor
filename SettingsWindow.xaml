<Window x:Class="TILageMonitor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen"
        Width="643"
        Height="908"
        MinWidth="555"
        MinHeight="756"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackground}"
        ShowInTaskbar="True">

    <Window.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SectionHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ChipBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextMain}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Einstellungen"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMain}"/>
            <TextBlock Text="Darstellung, Startverhalten, Updates und Benachrichtigungen"
                       FontSize="13"
                       Foreground="{DynamicResource TextMuted}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Sprache -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.11" Direction="270" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Sprache" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Sprache der Oberfläche auswählen"
                                   Style="{StaticResource SectionHintStyle}"/>
                        <RadioButton x:Name="LanguageSystemToggle"
                                     Content="Automatisch (Windows-Systemsprache)"
                                     GroupName="UiLanguage"
                                     Foreground="{DynamicResource TextMain}"
                                     Margin="0,0,0,7"
                                     Checked="Language_Changed"/>
                        <RadioButton x:Name="LanguageGermanToggle"
                                     Content="Deutsch"
                                     GroupName="UiLanguage"
                                     Foreground="{DynamicResource TextMain}"
                                     Margin="0,0,0,7"
                                     Checked="Language_Changed"/>
                        <RadioButton x:Name="LanguageEnglishToggle"
                                     Content="English"
                                     GroupName="UiLanguage"
                                     Foreground="{DynamicResource TextMain}"
                                     Checked="Language_Changed"/>
                        <TextBlock x:Name="LanguageRestartHint"
                                   Text="Die Auswahl wird nach einem Neustart der App übernommen."
                                   Style="{StaticResource SectionHintStyle}"
                                   Margin="0,10,0,8"/>
                        <Button x:Name="RestartForLanguageButton"
                                Content="Jetzt neu starten"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left"
                                Padding="16,9"
                                Visibility="Collapsed"
                                Click="RestartForLanguage_Click"/>
                    </StackPanel>
                </Border>

                <!-- Darstellung -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.11" Direction="270" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Darstellung" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Oberfläche der Anwendung"
                                   Style="{StaticResource SectionHintStyle}"/>
                        <CheckBox x:Name="DarkModeToggle"
                                  Content="Dunkelmodus"
                                  Style="{DynamicResource ThemeAwareCheckBoxStyle}"
                                  Checked="DarkModeToggle_Changed"
                                  Unchecked="DarkModeToggle_Changed"/>
                    </StackPanel>
                </Border>

                <!-- Start -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.11" Direction="270" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Start" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Beim Anmelden automatisch starten (mit --tray)"
                                   Style="{StaticResource SectionHintStyle}"/>
                        <CheckBox x:Name="AutoStartToggle"
                                  Content="Autostart"
                                  Style="{DynamicResource ThemeAwareCheckBoxStyle}"
                                  Checked="AutoStartToggle_Changed"
                                  Unchecked="AutoStartToggle_Changed"/>
                    </StackPanel>
                </Border>

                <!-- Updates -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.12" Direction="270" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Updates" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Beim Start wird automatisch nach einer neuen Version gesucht."
                                   Style="{StaticResource SectionHintStyle}"/>
                        <CheckBox x:Name="AutoInstallUpdatesToggle"
                                  Content="Updates automatisch installieren"
                                  Style="{DynamicResource ThemeAwareCheckBoxStyle}"
                                  Margin="0,0,0,8"
                                  Checked="AutoInstallUpdatesToggle_Changed"
                                  Unchecked="AutoInstallUpdatesToggle_Changed"/>
                        <TextBlock Text="Neue Releases werden heruntergeladen, per SHA-256 geprüft und nach dem Beenden der App ohne Assistent installiert."
                                   Style="{StaticResource SectionHintStyle}"
                                   Margin="0,0,0,10"/>
                        <TextBlock x:Name="UpdateStatusText"
                                   Text="Aktuelle Version wird beim Start automatisch geprüft."
                                   Style="{StaticResource SectionHintStyle}"
                                   Margin="0,0,0,10"/>
                        <Button x:Name="CheckForUpdatesButton"
                                Content="Nach Updates suchen"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left"
                                Padding="16,9"
                                Click="CheckForUpdates_Click"/>
                    </StackPanel>
                </Border>

                <!-- Benachrichtigungen -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.11" Direction="270" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Benachrichtigungen" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Toast-Meldungen pro Dienst (Tray-Icon-Farbe bleibt unverändert)"
                                   Style="{StaticResource SectionHintStyle}"/>
                        <CheckBox x:Name="NotificationsMasterToggle"
                                  Content="Benachrichtigungen aktiviert"
                                  Style="{DynamicResource ThemeAwareCheckBoxStyle}"
                                  Margin="0,0,0,10"
                                  Checked="NotificationsMaster_Changed"
                                  Unchecked="NotificationsMaster_Changed"/>
                        <TextBlock Text="Pro Dienst"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}"
                                   Margin="0,0,0,6"/>
                        <WrapPanel x:Name="NotifyServicesPanel" Orientation="Horizontal"/>
                    </StackPanel>
                </Border>


                <!-- Konnektor -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.11" Direction="270" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE968;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="20" Foreground="{DynamicResource TextMain}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Konnektor" Style="{StaticResource SectionHeaderStyle}"/>
                                <TextBlock Text="Lokale TI-Anbindung: Überwachung, Ereignisse und Verlauf. Zugangsdaten bleiben im Konnektor-Fenster."
                                           Style="{StaticResource SectionHintStyle}"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="ConnectorEnabledToggle"
                                  Content="Konnektor-Anbindung aktiv"
                                  Style="{DynamicResource ThemeAwareCheckBoxStyle}"
                                  Margin="0,0,0,8"
                                  Checked="ConnectorSetting_Changed"
                                  Unchecked="ConnectorSetting_Changed"/>
                        <CheckBox x:Name="ConnectorMonitoringToggle"
                                  Content="Im Hintergrund überwachen (Toasts)"
                                  Style="{DynamicResource ThemeAwareCheckBoxStyle}"
                                  Margin="0,0,0,8"
                                  Checked="ConnectorSetting_Changed"
                                  Unchecked="ConnectorSetting_Changed"/>
                        <CheckBox x:Name="ConnectorEventsToggle"
                                  Content="Ereignis-Abos (Karte rein/raus sofort)"
                                  Style="{DynamicResource ThemeAwareCheckBoxStyle}"
                                  Margin="0,0,0,8"
                                  Checked="ConnectorSetting_Changed"
                                  Unchecked="ConnectorSetting_Changed"/>
                        <CheckBox x:Name="ConnectorHistoryToggle"
                                  Content="Verlauf lokal speichern (14 Tage)"
                                  Style="{DynamicResource ThemeAwareCheckBoxStyle}"
                                  Margin="0,0,0,10"
                                  Checked="ConnectorSetting_Changed"
                                  Unchecked="ConnectorSetting_Changed"/>
                        <TextBlock Text="Konnektor-Benachrichtigungen" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMain}" Margin="0,2,0,6"/>
                        <CheckBox x:Name="ConnectorCertExpiryToggle"
                                  Content="Zertifikatsablauf melden (90, 30 und 7 Tage vorher)"
                                  Style="{DynamicResource ThemeAwareCheckBoxStyle}"
                                  Margin="0,0,0,8"
                                  Checked="ConnectorNotify_Changed"
                                  Unchecked="ConnectorNotify_Changed"/>
                        <CheckBox x:Name="ConnectorPinStatusToggle"
                                  Content="PIN-Status melden (SMC-B nicht freigeschaltet, PIN gesperrt, letzter Versuch)"
                                  Style="{DynamicResource ThemeAwareCheckBoxStyle}"
                                  Margin="0,0,0,8"
                                  Checked="ConnectorNotify_Changed"
                                  Unchecked="ConnectorNotify_Changed"/>
                        <TextBlock Text="Toasts bei Ereignissen" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,6"/>
                        <WrapPanel Margin="0,0,0,4">
                            <CheckBox x:Name="ToastCardRemovedToggle" Content="Karte entfernt"
                                      Style="{DynamicResource ThemeAwareCheckBoxStyle}" Margin="0,0,18,8"
                                      Checked="ConnectorNotify_Changed" Unchecked="ConnectorNotify_Changed"/>
                            <CheckBox x:Name="ToastCardInsertedToggle" Content="Karte gesteckt"
                                      Style="{DynamicResource ThemeAwareCheckBoxStyle}" Margin="0,0,18,8"
                                      Checked="ConnectorNotify_Changed" Unchecked="ConnectorNotify_Changed"/>
                            <CheckBox x:Name="ToastTerminalDisconnectedToggle" Content="Terminal getrennt"
                                      Style="{DynamicResource ThemeAwareCheckBoxStyle}" Margin="0,0,18,8"
                                      Checked="ConnectorNotify_Changed" Unchecked="ConnectorNotify_Changed"/>
                            <CheckBox x:Name="ToastTerminalConnectedToggle" Content="Terminal verbunden"
                                      Style="{DynamicResource ThemeAwareCheckBoxStyle}" Margin="0,0,18,8"
                                      Checked="ConnectorNotify_Changed" Unchecked="ConnectorNotify_Changed"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,10">
                            <TextBlock Text="Karten:" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Top" Margin="0,1,10,8"/>
                            <CheckBox x:Name="ToastForSmcBToggle" Content="SMC-B"
                                      Style="{DynamicResource ThemeAwareCheckBoxStyle}" Margin="0,0,18,8"
                                      Checked="ConnectorNotify_Changed" Unchecked="ConnectorNotify_Changed"/>
                            <CheckBox x:Name="ToastForHbaToggle" Content="HBA"
                                      Style="{DynamicResource ThemeAwareCheckBoxStyle}" Margin="0,0,18,8"
                                      Checked="ConnectorNotify_Changed" Unchecked="ConnectorNotify_Changed"/>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="Intervall" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="ConnectorPollBox" Width="58" Padding="8,6" LostFocus="ConnectorPoll_LostFocus"/>
                            <TextBlock Text="Min." FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="6,0,16,0"/>
                            <TextBlock Text="Zertifikatswarnung ab" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="ConnectorWarnBox" Width="58" Padding="8,6" LostFocus="ConnectorPoll_LostFocus"/>
                            <TextBlock Text="Tage" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <Button x:Name="OpenConnectorButton"
                                Content="Konnektor-Fenster öffnen"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left"
                                Padding="16,9"
                                Click="OpenConnector_Click"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Button Content="Schließen"
                    HorizontalAlignment="Right"
                    MinWidth="110"
                    Click="Close_Click"
                    Padding="16,10"/>
        </Grid>
    </Grid>
</Window>
